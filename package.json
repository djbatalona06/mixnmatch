{
  "name": "mixnmatch",
  "version": "0.1.0",
  "private": true,
  "description": "mix n match: one app to move your playlists and liked songs between music services, and keep them in sync.",
  "type": "module",
  "scripts": {
    "dev": "vite build --config app/vite.config.ts && vercel dev --listen 8787",
    "dev:app": "vite --config app/vite.config.ts",
    "build": "node scripts/migrate.mjs && vite build --config app/vite.config.ts",
    "build:app": "vite build --config app/vite.config.ts",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "vercel deploy --prod",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "test": "vitest run",
    "smoke": "node test/smoke.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "layout:check": "vite build --config app/vite.config.ts && node test/layout.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vercel": "^65.2.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.16"
  }
}
