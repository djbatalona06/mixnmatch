# Copy this file to .env.local for local testing. Never commit .env.local.
# Make a key with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_KEY=
CRON_SECRET=
DEV_MODE=1
ENABLE_MOCK=1

# Database. Leave these empty to use a local file (.data/local.db).
# On Vercel, the Turso integration sets them for you.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Fill in the services you have developer apps for (leave the rest empty):
SPOTIFY_CLIENT_ID=
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
DEEZER_APP_ID=
DEEZER_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
RESEND_API_KEY=

# Premium payments (Stripe test mode first). Leave empty to hide Premium.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
