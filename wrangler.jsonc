// Cloudflare settings for mix n match.
// Everything here works on the Workers Free plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mixnmatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The website files (HTML, CSS, JS) in /public.
  // Requests to /api/* always go to our Worker code first.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // The database. Run `npx wrangler d1 create mixnmatch` and paste the id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mixnmatch",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // One TransferJob object runs each transfer in small steps.
  "durable_objects": {
    "bindings": [{ "name": "TRANSFER_JOB", "class_name": "TransferJob" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TransferJob"] }],

  // Daily clean-up of old logins and old transfer details (03:17 UTC).
  "triggers": { "crons": ["17 3 * * *"] },

  "vars": {
    "EMAIL_FROM": "mix n match <onboarding@resend.dev>",
    "DEV_MODE": "0",
    "ENABLE_MOCK": "0"
  },

  "observability": { "enabled": true }
}
