{
  "name": "mixnmatch",
  "version": "0.1.0",
  "private": true,
  "description": "mix n match: move your playlists and liked songs between music services.",
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel deploy --prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node test/smoke.mjs",
    "build": "node scripts/migrate.mjs",
    "smoke:deploy": "node scripts/smoke-deploy.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vercel": "^65.2.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0"
  }
}
