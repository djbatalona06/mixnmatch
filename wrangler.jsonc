// Cloudflare settings for mix n match.
// Everything here works on the Workers Free plan.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mixnmatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The app (built from /app into /dist by `npm run build`, which wrangler runs first).
  // Any page address loads the app; requests to /api/* always go to our Worker code first.
  "build": { "command": "npm run build", "watch_dir": "app/src" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The database. Run `npx wrangler d1 create mixnmatch` and paste the id here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mixnmatch",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // One TransferJob object runs each transfer in small steps.
  "durable_objects": {
    "bindings": [{ "name": "TRANSFER_JOB", "class_name": "TransferJob" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TransferJob"] }],

  // Daily clean-up of old logins and old transfer details (03:17 UTC),
  // and an hourly check for Auto-Syncs that are due (2 of the 5 crons the free plan allows).
  "triggers": { "crons": ["17 3 * * *", "7 * * * *"] },

  "vars": {
    "EMAIL_FROM": "mix n match <onboarding@resend.dev>",
    "DEV_MODE": "0",
    "ENABLE_MOCK": "0"
  },

  "observability": { "enabled": true }
}
